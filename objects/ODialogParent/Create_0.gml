dialog = new Dialogue(); // Create new dialogue object 

key_next = vk_anykey; // Press any key to continue

showing_dialog = false; // Tracks whether the dialog is shown or not, not initially
animating_textbox = false; // Tracks if typing
current_dialog = {}; // An empty object holds the dialogur content 

alpha = 0; // Invisible initially 

char_current = 1; // Starts to type at first character
char_speed = 0.375; // Typing speed




