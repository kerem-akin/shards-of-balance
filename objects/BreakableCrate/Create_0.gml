hp = 5; // Default health
textbox = noone; // Tracks if textbox exists or not, doesnt at the start
fade_in_speed = 0.015; // Speed in which textbox fades in
fade_out_speed = 0.03; // Speed in which textbox fades out
textbox_alpha = 0; // Tracks textboxs visibility, invisible initially

flash = 0; // Tracks the shader effect when hit, nothing initially
hitfrom = 0; // Tracks directions of the hit received

image_xscale = 1.6; // Width scaled by x1.6
image_yscale = 1.6; // Height scaled by x1.6