textbox = noone; // Tracks whether textbox exists or not, doesnt at the start
fade_in_speed = 0.015; // Speed of fading in
fade_out_speed = 0.03; // Speed of fading out
textbox_alpha = 0; // Initially invisible

image_xscale = 2; // Scaled x2 in width
image_yscale = 2; // Scaled x2 in height
