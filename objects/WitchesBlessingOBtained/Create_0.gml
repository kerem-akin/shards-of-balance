image_xscale = 0.8; // Scaled down 0.9x
image_yscale = 0.8; // Scaled down 0.9x

image_alpha = 0; // Start transparent

fadingOut = false; // Not fading out at the start

audio_play_sound(FireBallAbilityPickUp,1,false) // Play the pickup sound once
audio_sound_gain(FireBallAbilityPickUp,3,0) // Play it louder

